<div class="flex h-screen overflow-hidden bg-neutral-100 ">
  <%= render "sidebar" %>

  <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <div class="shrink-0 px-6 py-4 border-b border-black/10 bg-white">
      <turbo-frame id="geolocation_picker">
        <%= render "geolocation_form" %>
      </turbo-frame>
    </div>

    <div class="flex-1 overflow-y-auto px-6 py-6">
      <turbo-frame id="weather_result">
        <%= render "current" %>
        <%= render "hourly" %>
        <%= render "daily" %>
      </turbo-frame>
    </div>

  </main>
</div>