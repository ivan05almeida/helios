<div class="bg-white border border-black/10 rounded-xl shadow-xs overflow-hidden">
  <div class="px-5 py-4 border-b border-black/10 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="size-8 rounded-lg bg-green-500 flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-white" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z" clip-rule="evenodd" />
        </svg>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-neutral-900"><%= @weather.location_name %></h2>
        <p class="text-xs text-neutral-500">Weather fetched successfully</p>
      </div>
    </div>
    <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-700">
      Live
    </span>
  </div>

  <div class="p-5 space-y-3">
    <div class="rounded-lg bg-neutral-50 border border-black/10 divide-y divide-black/10">
      <div class="flex items-center justify-between px-4 py-2.5">
        <span class="text-xs text-neutral-500">Latitude</span>
        <span class="font-mono text-xs text-neutral-900"><%= @weather.latitude %></span>
      </div>
      <div class="flex items-center justify-between px-4 py-2.5">
        <span class="text-xs text-neutral-500">Longitude</span>
        <span class="font-mono text-xs text-neutral-900"><%= @weather.longitude %></span>
      </div>
      <div class="flex items-center justify-between px-4 py-2.5">
        <span class="text-xs text-neutral-500">Zipcode</span>
        <span class="font-mono text-xs text-neutral-900"><%= @weather.zipcode.presence || "—" %></span>
      </div>
    </div>
  </div>

  <div class="px-5 py-4 border-t border-black/10">
    <%= link_to new_weather_path,
          data: { turbo_frame: "geolocation_picker" },
          class: "inline-flex items-center gap-1.5 text-sm text-neutral-500
                  hover:text-neutral-900 transition-colors" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      Search again
    <% end %>
  </div>
</div>