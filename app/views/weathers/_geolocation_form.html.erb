<%= form_with url: weather_path,
      method: :get,
      id: "geolocation-form",
      data: {
        controller: "places",
        turbo_frame: "weather_result",
        action: "submit->places#submit"
      } do |f| %>

  <div class="flex items-center gap-3">
    <div class="relative flex-1" data-places-target="searchWrapper">
      <div class="pointer-events-none absolute inset-y-0 left-3 flex items-center z-10">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </div>

      <input
        type="text"
        placeholder="Search for a city, address or place..."
        data-places-target="input"
        autocomplete="off"
        class="w-full rounded-lg border border-black/10
               bg-neutral-50 pl-9 pr-4 py-2.5 text-sm
               text-neutral-900 placeholder:text-neutral-400
               focus:outline-none focus:ring-2 focus:ring-neutral-900
               transition-shadow"
      />

      <div data-places-target="spinner" class="hidden absolute inset-y-0 right-3 flex items-center">
        <svg class="size-4 animate-spin text-neutral-400" viewBox="0 0 24 24" fill="none">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
        </svg>
      </div>

      <div data-places-target="dropdown"
           class="hidden absolute left-0 right-0 top-full mt-1 z-50
                  rounded-lg border border-black/10 bg-white shadow-lg
                  max-h-64 overflow-y-auto">
      </div>
    </div>

    <div data-places-target="alert" class="hidden shrink-0 text-xs text-red-500">
      Select a place first
    </div>

    <%# Hidden fields %>
    <%= f.hidden_field :name,      data: { places_target: "name" } %>
    <%= f.hidden_field :latitude,  data: { places_target: "latitude" } %>
    <%= f.hidden_field :longitude, data: { places_target: "longitude" } %>
    <%= f.hidden_field :zipcode,   data: { places_target: "zipcode" } %>
    <%= f.hidden_field :location_timezone, data: { places_target: "timezone" } %>

    <label class="shrink-0 flex items-center gap-2 cursor-pointer">
      <input type="checkbox"
            name="force"
            value="true"
            class="rounded border-black/20 text-neutral-900 focus:ring-neutral-900 bg-white">
      <span class="text-sm text-neutral-500">Force refresh</span>
    </label>

    <%= f.submit "Fetch weather",
          disabled: true,
          data: { places_target: "submit" },
          class: "shrink-0 cursor-pointer rounded-lg bg-neutral-900
                  px-4 py-2.5 text-sm font-medium
                  text-white transition-colors hover:bg-neutral-700
                  disabled:opacity-40 disabled:cursor-not-allowed" %>
  </div>

<% end %>