<div class="mb-4">
  <h2 class="text-xs font-semibold uppercase tracking-widest text-neutral-500 mb-3">
    Next 24 hours
  </h2>

  <div class="overflow-x-auto pb-2 -mx-6 px-6">
    <div class="flex gap-2" style="width: max-content">
      <% @forecast.hourly.each do |hour| %>
        <%= render "hourly_card", hour: hour %>
      <% end %>
    </div>
  </div>
</div>