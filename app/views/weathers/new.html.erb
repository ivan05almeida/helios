<div class="flex h-screen overflow-hidden bg-neutral-100">
  <%= render "sidebar" %>

  <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <div class="shrink-0 px-6 py-4 border-b border-black/10 bg-white">
      <turbo-frame id="geolocation_picker">
        <%= render "geolocation_form" %>
      </turbo-frame>
    </div>

    <div class="flex-1 overflow-y-auto px-6 py-6">
      <turbo-frame id="weather_result">
        <div class="flex h-full items-center justify-center text-neutral-400 dark:text-neutral-600 select-none">
          <div class="text-center space-y-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z"/>
            </svg>
            <p class="text-sm">Search for a location to see the forecast</p>
          </div>
        </div>
      </turbo-frame>
    </div>

  </main>
</div>